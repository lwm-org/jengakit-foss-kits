# Engine files vendored into this repo. The engine (lwm-org/jengakit) is the
# source of record, and its "Kits repo copies" check compares these copies with
# the engine's files on this repo's dev branch. A change to a copied file lands
# in this order: open both pull requests together, merge this repo's one into
# dev first (do not release it), re-run the engine check and merge the engine
# pull request, cut the engine release, then merge dev to main here the same
# day. Record the engine merge commit and release below.
engine_repo: lwm-org/jengakit
engine_commit: e8f64dabfd4e7239fb6f66547972215d84644365
engine_release: v0.10.0


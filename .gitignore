# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Build output
dist/
build/

# Local data. Kit files under any data/ folder are kit content and stay
# tracked (kits/moms-bible/templates/public/data/ ships in its bundle).
data/
!kits/**/data/
!kits/**/data/**

# Kit bundles packed locally by scripts/publish-kits.py --dry-run --out
bundles/

# Logs
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Secrets, never commit
.env
*.env
!.env.example

{
  "schema_version": "7",
  "kit_name": "rpi-neopixel-status",
  "kit_family": "embedded",
  "version": "1.0.2",
  "kit_min_jengakit_version": "0.10.0",
  "display_name": "Pi NeoPixel ambient status",
  "description": "Drives a WS2812/NeoPixel strip as an ambient status light \u2014 a color wash you can drive from weather, system, or CI state.",
  "category": "embedded",
  "author": "jengakit",
  "capabilities": [
    "embedded",
    "rpi"
  ],
  "ui": {
    "pill_label": "Pi NeoPixel ambient stat",
    "hint": "e.g. slow rainbow, green when healthy",
    "description": "Drives a WS2812/NeoPixel strip as an ambient status light \u2014 a color wash you can drive from weather, system, or CI state."
  },
  "sample_prompts": [
    "Slow rainbow wash",
    "Solid green ambient glow",
    "Pulse blue"
  ],
  "kit_target": {
    "platform": "rpi-4",
    "variant": "rpi-4"
  },
  "kit_toolchain": "ssh-python",
  "kit_flash_methods": [
    "ssh-rsync"
  ],
  "kit_safety_class": "benign",
  "kit_required_peripherals": [
    {
      "type": "led-strip",
      "pin": "GPIO18"
    }
  ],
  "kit_template_dir": "templates",
  "kit_required_wiring": [
    {
      "from": "WS2812 DIN",
      "to": "GPIO18",
      "note": "level-shift for 5V strips"
    },
    {
      "from": "WS2812 5V",
      "to": "5V",
      "note": "external supply for many LEDs"
    },
    {
      "from": "WS2812 GND",
      "to": "GND",
      "note": "common ground"
    }
  ]
}

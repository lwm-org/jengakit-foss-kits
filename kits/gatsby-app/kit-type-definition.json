{
  "schema_version": "7",
  "kit_name": "gatsby-app",
  "kit_family": "codegen",
  "version": "1.1.4",
  "display_name": "Gatsby App",
  "description": "Gatsby site styled with Tailwind CSS, built from your description. Everything lives in the one page file.",
  "category": "frontend",
  "author": "jengakit",
  "kit_min_jengakit_version": "0.10.0",
  "kit_language": "node",
  "kit_base_image": "node:20-slim",
  "kit_port": 3000,
  "kit_network": {
    "ingress_variant": "standard"
  },
  "kit_deploy": {
    "method": "deployment",
    "validate_method": "http-check"
  },
  "capabilities": [
    "http",
    "ingress"
  ],
  "ui": {
    "pill_label": "Gatsby",
    "hint": "e.g. a marketing page for a gym, a portfolio site, a pricing page, an about page",
    "description": "Gatsby page built from your description."
  },
  "sample_prompts": [
    "A marketing page for a gym with class times and a trial sign-up form",
    "A photography portfolio with a gallery grid and a contact section",
    "A pricing page with three plans and a FAQ",
    "A company about page with team profiles and a timeline"
  ],
  "kit_template_dir": "templates",
  "kit_required_files": [
    "Dockerfile",
    "package.json",
    "gatsby-config.js",
    "postcss.config.cjs",
    "tailwind.config.cjs",
    "tsconfig.json",
    "src/styles/global.css",
    "src/pages/index.tsx",
    "gatsby-ssr.js",
    "static/favicon.svg"
  ],
  "kit_template_overlay_exclude": [
    "src/pages/index.tsx"
  ],
  "kit_template_overlay_force": [
    "gatsby-config.js",
    "gatsby-ssr.js",
    "tsconfig.json",
    "src/styles/global.css",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "static/favicon.svg"
  ],
  "kit_prompts": {
    "codegen_rules": "prompts/codegen-rules.txt"
  },
  "resources": {
    "cpu": "s",
    "memory": "s",
    "storage": "none"
  }
}

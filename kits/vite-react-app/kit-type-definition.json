{
  "schema_version": "5",
  "kit_name": "vite-react-app",
  "kit_family": "codegen",
  "version": "1.1.3",
  "display_name": "React App (Vite)",
  "description": "React app styled with Tailwind CSS, built from your description. Everything lives in the one page file.",
  "category": "frontend",
  "author": "jengakit",
  "kit_min_jengakit_version": "0.1.0",
  "kit_language": "node",
  "kit_base_image": "node:20-slim",
  "kit_port": 80,
  "kit_network": {
    "ingress_variant": "standard"
  },
  "kit_deploy": {
    "method": "deployment",
    "validate_method": "http-check"
  },
  "capabilities": [
    "http",
    "ingress"
  ],
  "ui": {
    "pill_label": "React (Vite)",
    "hint": "e.g. a landing page for a bakery, a portfolio site, a pricing page, a product tour",
    "description": "React page built from your description."
  },
  "sample_prompts": [
    "A landing page for a bakery with a menu and opening hours",
    "A portfolio site for an illustrator with a contact section",
    "A pricing page with three plans and a FAQ",
    "A product tour page with feature sections and a sign-up form"
  ],
  "kit_template_dir": "templates",
  "kit_required_files": [
    "Dockerfile",
    "package.json",
    "vite.config.ts",
    "postcss.config.cjs",
    "tailwind.config.cjs",
    "nginx.conf",
    "index.html",
    "src/main.tsx",
    "src/index.css",
    "src/App.tsx",
    "public/favicon.svg"
  ],
  "kit_template_overlay_exclude": [
    "src/App.tsx"
  ],
  "kit_template_overlay_force": [
    "index.html",
    "src/main.tsx",
    "src/index.css",
    "vite.config.ts",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "nginx.conf",
    "public/favicon.svg"
  ],
  "kit_prompts": {
    "codegen_rules": "prompts/codegen-rules.txt"
  },
  "estimate": {
    "cpu_m": 10,
    "mem_mb": 48
  }
}

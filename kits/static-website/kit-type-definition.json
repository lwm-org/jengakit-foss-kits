{
  "schema_version": "7",
  "kit_name": "static-website",
  "kit_family": "codegen",
  "version": "1.1.5",
  "display_name": "Static Website",
  "description": "Static website, one page or several, built from your description. Pure HTML, CSS and JavaScript; download it and host it anywhere.",
  "category": "frontend",
  "author": "jengakit",
  "kit_min_jengakit_version": "0.10.0",
  "kit_language": "dockerfile-only",
  "kit_base_image": "nginx:alpine",
  "kit_port": 80,
  "kit_template_overlay_force": [
    "nginx.conf",
    "favicon.svg"
  ],
  "kit_network": {
    "ingress_variant": "standard"
  },
  "kit_deploy": {
    "method": "deployment",
    "validate_method": "http-check"
  },
  "capabilities": [
    "http",
    "ingress"
  ],
  "ui": {
    "pill_label": "Website",
    "hint": "e.g. a portfolio site, landing page, restaurant website, or company brochure",
    "description": "Pure HTML, CSS and JavaScript. Download it and host it anywhere."
  },
  "sample_prompts": [
    "A portfolio website for a photographer with a gallery and a contact section",
    "A restaurant website with menu, opening hours and directions",
    "A startup landing page with feature sections, pricing and a sign-up form"
  ],
  "kit_template_dir": "templates",
  "kit_required_files": [
    "Dockerfile",
    "nginx.conf",
    "index.html",
    "favicon.svg"
  ],
  "kit_template_overlay_exclude": [
    "index.html"
  ],
  "kit_prompts": {
    "interpret_hints": "prompts/interpret-hints.txt",
    "plan_rules": "prompts/plan-rules.txt",
    "codegen_rules": "prompts/codegen-rules.txt",
    "infra_rules": "prompts/infra-rules.txt"
  },
  "kit_prompt_prefix": "Build a modern, responsive static website using HTML and CSS. ",
  "resources": {
    "cpu": "xs",
    "memory": "xs",
    "storage": "none"
  },
  "user_inputs": [
    {
      "id": "css_framework",
      "label": "CSS Framework",
      "type": "select",
      "required": false,
      "secret": false,
      "purpose": "runtime_env",
      "group": "Design",
      "env_var": "CSS_FRAMEWORK",
      "hint": "Choose a CSS framework for styling",
      "options": [
        {
          "value": "tailwind",
          "label": "Tailwind CSS"
        },
        {
          "value": "bootstrap",
          "label": "Bootstrap 5"
        },
        {
          "value": "bulma",
          "label": "Bulma"
        },
        {
          "value": "none",
          "label": "Plain HTML/CSS"
        }
      ],
      "default": "tailwind"
    }
  ]
}

{
  "schema_version": "7",
  "kit_name": "arduino-morse-beacon",
  "kit_family": "embedded",
  "version": "1.0.2",
  "kit_min_jengakit_version": "0.10.0",
  "display_name": "Arduino Morse beacon",
  "description": "Blinks any message in Morse code on the Uno's onboard LED (pin 13). No wiring \u2014 onboard LED only.",
  "category": "embedded",
  "author": "jengakit",
  "capabilities": [
    "embedded"
  ],
  "ui": {
    "pill_label": "Arduino Morse beacon",
    "hint": "e.g. blink SOS, send HELLO WORLD, beacon my callsign",
    "description": "Blinks any message in Morse code on the Uno's onboard LED (pin 13). No wiring \u2014 onboard LED only."
  },
  "sample_prompts": [
    "Blink SOS on repeat",
    "Send HELLO in Morse",
    "Beacon the word JENGA slowly"
  ],
  "kit_target": {
    "platform": "arduino-uno",
    "variant": "atmega328p"
  },
  "kit_toolchain": "platformio",
  "kit_flash_methods": [
    "usb-serial-web"
  ],
  "kit_safety_class": "benign",
  "kit_required_peripherals": [
    {
      "type": "led-onboard"
    }
  ],
  "kit_template_dir": "templates",
  "kit_prompts": {
    "codegen": "prompts/codegen-rules.txt"
  }
}
